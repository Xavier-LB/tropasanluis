	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"catalogo": "node --import tsx scripts/catalogo/manage.ts",
		"test:catalogo": "node --import tsx --test tests/catalogo/*.test.ts",
		"check:catalogo": "tsc --noEmit -p tsconfig.catalog.json"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
