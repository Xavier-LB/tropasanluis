      "html": "<nav class=\"ds-subnav\" aria-label=\"Sitios de campamento\"><a href=\"/sitios\" aria-current=\"page\">Catálogo</a><a href=\"/sitios/historial\">Campamentos y visitas</a><a href=\"/sitios/aportar\">Aportar un dato</a></nav>",
